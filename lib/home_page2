import 'package:flutter/material.dart';
// Import yang diperlukan untuk navigasi ke ProductDetailPage
import 'package:flutter_application_6/models/product.dart';
import 'package:flutter_application_6/product_detail_page.dart';

class HomePage extends StatefulWidget {
  const HomePage({Key? key}) : super(key: key);

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  int halamanAktif = 0;

  final List<String> namaProduk = [
    'Kaos Keren',
    'Celana Jeans',
    'Sepatu Sport',
    'Tas Sekolah',
    'Jaket Hoodie',
    'Jam Tangan',
  ];

  final List<String> hargaProduk = [
    'Rp 50.000',
    'Rp 150.000',
    'Rp 200.000',
    'Rp 75.000',
    'Rp 125.000',
    'Rp 35.000',
  ];

  final List<String> gambarProduk = [
    'assets/img/tshirt.webp',
    'assets/img/jeans.jpeg',
    'assets/img/shoes.jpeg',
    'assets/img/bag.jpg',
    'assets/img/hoodie.jpg',
    'assets/img/watch.jpg',
  ];

  // Method helper untuk mengkonversi harga dari String ke double
  double _convertPrice(String priceString) {
    // Menghilangkan 'Rp ' dan '.' dari string harga
    String cleanPrice = priceString.replaceAll('Rp ', '').replaceAll('.', '');
    return double.parse(cleanPrice);
  }

  // Method helper untuk membuat object Product dari data list
  Product _createProduct(int index) {
    return Product(
      id: (index + 1).toString(),
      name: namaProduk[index],
      price: _convertPrice(hargaProduk[index]),
      image: gambarProduk[index],
      rating: _getProductRating(index), // Rating berbeda untuk setiap produk
      description: _getProductDescription(index),
    );
  }

  // Method helper untuk memberikan rating produk berdasarkan index
  double _getProductRating(int index) {
    switch (index) {
      case 0:
        return 4.5; // Kaos Keren
      case 1:
        return 4.2; // Celana Jeans
      case 2:
        return 4.8; // Sepatu Sport
      case 3:
        return 4.0; // Tas Sekolah
      case 4:
        return 4.6; // Jaket Hoodie
      case 5:
        return 4.3; // Jam Tangan
      default:
        return 4.0;
    }
  }

  // Method helper untuk memberikan deskripsi produk berdasarkan index
  String _getProductDescription(int index) {
    switch (index) {
      case 0:
        return 'Kaos dengan bahan katun berkualitas tinggi, nyaman dipakai sehari-hari dengan desain yang trendy dan modern. Material 100% cotton yang breathable dan tahan lama.';
      case 1:
        return 'Celana jeans premium dengan bahan denim berkualitas, cocok untuk gaya kasual maupun semi formal. Desain slim fit yang mengikuti bentuk tubuh dengan sempurna.';
      case 2:
        return 'Sepatu olahraga dengan teknologi terdepan untuk kenyamanan maksimal saat beraktivitas dan berolahraga. Dilengkapi dengan sol anti-slip dan bantalan empuk.';
      case 3:
        return 'Tas sekolah dengan desain ergonomis dan banyak compartment untuk menyimpan buku dan peralatan sekolah. Terbuat dari bahan tahan air dan ringan.';
      case 4:
        return 'Jaket hoodie hangat dan stylish, perfect untuk cuaca dingin dengan bahan fleece yang lembut. Dilengkapi dengan kantong depan dan hood yang dapat disesuaikan.';
      case 5:
        return 'Jam tangan elegant dengan desain minimalis dan fitur-fitur modern untuk gaya hidup aktif Anda. Tahan air dan dilengkapi dengan stopwatch digital.';
      default:
        return 'Produk berkualitas tinggi dengan harga terjangkau untuk kebutuhan sehari-hari Anda.';
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Toko Online Ku'),
        backgroundColor: Colors.blue,
        actions: [
          PopupMenuButton<String>(
            icon: const Icon(Icons.people_alt),
            onSelected: (String value) {
              switch (value) {
                case 'profile':
                  Navigator.pushNamed(context, '/profile');
                  break;
                case 'cart':
                  Navigator.pushNamed(context, '/cart');
                  break;
                case 'logout':
                  _showLogoutDialog(context);
                  break;
              }
            },
            itemBuilder: (BuildContext context) => <PopupMenuEntry<String>>[
              const PopupMenuItem<String>(
                value: 'cart',
                child: ListTile(
                  leading: Icon(Icons.shopping_cart),
                  title: Text('Keranjang'),
                  contentPadding: EdgeInsets.zero,
                ),
              ),
              const PopupMenuItem<String>(
                value: 'profile',
                child: ListTile(
                  leading: Icon(Icons.person),
                  title: Text('Profil'),
                  contentPadding: EdgeInsets.zero,
                ),
              ),
              const PopupMenuDivider(),
              const PopupMenuItem<String>(
                value: 'logout',
                child: ListTile(
                  leading: Icon(Icons.logout, color: Colors.red),
                  title: Text('Logout', style: TextStyle(color: Colors.red)),
                  contentPadding: EdgeInsets.zero,
                ),
              ),
            ],
          ),
        ],
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text(
              'Produk Terpopuler',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 16),
            Expanded(
              child: GridView.builder(
                itemCount: namaProduk.length,
                gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: 2,
                  crossAxisSpacing: 16,
                  mainAxisSpacing: 8,
                  childAspectRatio: 0.7,
                ),
                itemBuilder: (context, index) {
                  return Card(
                    elevation: 4,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: InkWell(
                      borderRadius: BorderRadius.circular(12),
                      // Ganti onTap untuk navigasi ke ProductDetailPage
                      onTap: () {
                        // Membuat object Product dari data yang ada
                        Product product = _createProduct(index);

                        // Navigasi ke ProductDetailPage dengan membawa data product
                        Navigator.push(
                          context,
                          MaterialPageRoute(
                            builder: (context) =>
                                ProductDetailPage(product: product),
                          ),
                        );
                      },
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.stretch,
                        children: [
                          Expanded(
                            child: ClipRRect(
                              borderRadius: const BorderRadius.vertical(
                                top: Radius.circular(12),
                              ),
                              child: Hero(
                                // Hero animation untuk transisi gambar yang smooth
                                tag: 'product_${index}',
                                child: Image.asset(
                                  gambarProduk[index],
                                  fit: BoxFit.cover,
                                  errorBuilder: (context, error, stackTrace) {
                                    return const Icon(
                                      Icons.broken_image,
                                      size: 60,
                                    );
                                  },
                                ),
                              ),
                            ),
                          ),
                          Padding(
                            padding: const EdgeInsets.all(8),
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  namaProduk[index],
                                  style: const TextStyle(
                                    fontWeight: FontWeight.bold,
                                  ),
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                ),
                                const SizedBox(height: 4),
                                Text(
                                  hargaProduk[index],
                                  style: const TextStyle(
                                    color: Colors.deepPurple,
                                    fontWeight: FontWeight.w600,
                                  ),
                                ),
                                const SizedBox(height: 4),
                                // Menambahkan rating stars di grid
                                Row(
                                  children: [
                                    Icon(
                                      Icons.star,
                                      color: Colors.amber,
                                      size: 14,
                                    ),
                                    const SizedBox(width: 2),
                                    Text(
                                      '${_getProductRating(index)}',
                                      style: const TextStyle(
                                        fontSize: 12,
                                        color: Colors.grey,
                                      ),
                                    ),
                                  ],
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
      bottomNavigationBar: BottomNavigationBar(
        backgroundColor: Colors.blue,
        selectedItemColor: Colors.white,
        unselectedItemColor: Colors.white70,
        currentIndex: halamanAktif,
        type: BottomNavigationBarType.fixed,
        elevation: 8,
        selectedFontSize: 12,
        unselectedFontSize: 12,
        onTap: (index) {
          ScaffoldMessenger.of(context).hideCurrentSnackBar();
          setState(() {
            halamanAktif = index;
          });

          String pesan = '';
          if (index == 0) {
            pesan = 'Halaman Beranda';
          } else if (index == 1) {
            pesan = 'Halaman Chat';
            Navigator.pushNamed(context, '/chat-List');
          } else if (index == 2) {
            pesan = 'Halaman Favorit';
          }

          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(
              content: Text(pesan),
              duration: const Duration(milliseconds: 250),
            ),
          );
        },
        items: [
          const BottomNavigationBarItem(
            icon: Icon(Icons.home),
            label: 'Beranda',
          ),
          BottomNavigationBarItem(
            icon: Stack(
              alignment: Alignment.center,
              children: [
                Container(
                  padding: const EdgeInsets.all(8),
                  decoration: BoxDecoration(
                    color: halamanAktif == 1
                        ? Colors.white.withOpacity(0.2)
                        : Colors.transparent,
                    borderRadius: BorderRadius.circular(20),
                  ),
                  child: Icon(
                    Icons.chat,
                    size: 28,
                    color: halamanAktif == 1 ? Colors.white : Colors.white70,
                  ),
                ),
                Positioned(
                  right: 0,
                  top: 0,
                  child: Container(
                    padding: const EdgeInsets.all(4),
                    decoration: const BoxDecoration(
                      color: Colors.red,
                      shape: BoxShape.circle,
                    ),
                    child: const Text(
                      '3',
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 10,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ),
              ],
            ),
            label: 'Chat',
          ),
          const BottomNavigationBarItem(
            icon: Icon(Icons.favorite),
            label: 'Favorit',
          ),
        ],
      ),
    );
  }

  void _showLogoutDialog(BuildContext context) {
    showDialog(
      context: context,
      builder: (context) => AlertDialog(
        title: const Text('Logout'),
        content: const Text('Apakah Anda yakin ingin logout?'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Batal'),
          ),
          TextButton(
            onPressed: () {
              Navigator.pop(context);
              Navigator.pushReplacementNamed(context, '/');
            },
            child: const Text('Logout', style: TextStyle(color: Colors.red)),
          ),
        ],
      ),
    );
  }
}
